{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./out",
		"skipLibCheck": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"declaration": false,
		"types": [
			"node"
		],
		"typeRoots": [
			"../node_modules/@types"
		]
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"src/**/*.test.ts"
	]
}
