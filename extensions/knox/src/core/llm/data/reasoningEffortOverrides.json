      "default": "high"
    },
    "openai/gpt-6-sol": {
      "allowed": ["none", "low", "medium", "high", "xhigh"],
      "default": "none"
    },
    "openai/gpt-6-sol-pro": {
      "allowed": ["none", "low", "medium", "high", "xhigh"],
      "default": "high"
    },
    "openai/gpt-6-luna": {
      "allowed": ["none", "low", "medium", "high", "xhigh"],
      "default": "none"
    },
    "openai/gpt-5.6-terra": {
      "allowed": ["none", "low", "medium", "high", "xhigh"],
      "default": "medium"
    },
    "openai/gpt-6.1-sol": {
      "allowed": ["none", "low", "medium", "high", "xhigh"],
      "default": "high"
    }
  }
