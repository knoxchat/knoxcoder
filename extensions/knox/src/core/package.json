{
  "name": "knoxdev-core",
  "version": "1.2.0",
  "description": "The Knox Core contains functionality that can be shared across web, VS Code, or Node.js",
  "scripts": {
    "tsc:check": "tsc -p ./ --noEmit",
    "build:npm": "tsc -p ./tsconfig.npm.json",
    "test": "vitest run",
    "test:eval": "vitest run eval",
    "test:watch": "vitest"
  },
  "type": "module",
  "author": "knoxchat",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/win-ca": "^3.5.4",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@octokit/rest": "^22.0.1",
    "dbinfoz": "^0.14.0",
    "diff": "^9.0.0",
    "dotenv": "^18.0.0",
    "fastest-levenshtein": "^1.0.16",
    "handlebars": "^4.7.9",
    "i18next": "^26.4.2",
    "ignore": "^7.0.9",
    "jsdom": "^30.1.0",
    "knoxdev-package": "file:../pkg",
    "mac-ca": "^3.1.3",
    "node-html-markdown": "^2.0.0",
    "openai": "^7.18.0",
    "partial-json": "^0.1.7",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "system-ca": "^3.0.0",
    "tree-sitter-wasms": "^0.1.13",
    "uuid": "^14.0.2",
    "web-tree-sitter": "^0.27.0",
    "win-ca": "^3.5.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "overrides": {
    "sqlite3": "^6.0.1",
    "zod": "^4.6.5",
    "dbinfoz": {
      "@tootallnate/once": "^3.0.1"
    },
    "knoxdev-package": {
      "openai": "$openai",
      "zod": "^4.6.4"
    }
  },
  "engine-strict": true,
  "engines": {
    "node": ">=24.19.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "macos-export-certificate-and-key": true,
    "sqlite3": true,
    "win-ca": true
  }
}
