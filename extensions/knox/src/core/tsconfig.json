{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "noEmitOnError": false,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "knoxdev-package/config-yaml": ["../pkg/config-yaml/index.ts"],
      "knoxdev-package/fetch": ["../pkg/fetch/index.ts"],
      "knoxdev-package/openai-adapters": ["../pkg/openai-adapters/index.ts"],
      "knoxdev-package/openai-adapters/apis/base": ["../pkg/openai-adapters/apis/base.ts"]
    }
  },
  "include": ["./**/*.ts", "./**/*.js", "./**/*.d.ts", "./**/*.json"],
  "exclude": ["dist"]
}
