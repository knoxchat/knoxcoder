      "default": "high"
    },
    "anthropic/claude-opus-4.6": {
      "allowed": ["medium", "high", "max"],
      "default": "high"
    },
    "anthropic/claude-opus-4.7": {
      "allowed": ["high", "xhigh", "max"],
      "default": "xhigh"
    },
    "anthropic/claude-opus-4.8": {
      "allowed": ["high", "xhigh", "max"],
      "default": "xhigh"
    },
    "anthropic/claude-opus-5": {
      "allowed": ["high", "xhigh", "max"],
      "default": "xhigh"
    },
    "anthropic/claude-fable-5": {
      "allowed": ["low", "medium", "high", "max"],
      "default": "high"
    },
    "openai/gpt-5.4": {
