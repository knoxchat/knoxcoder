{
	"name": "knox",
	"displayName": "%displayName%",
	"description": "%description%",
	"publisher": "vscode",
	"license": "MIT",
	"version": "10.0.0",
	"engines": {
		"vscode": "^1.5.0"
	},
	"icon": "media/icon.png",
	"categories": [
		"AI",
		"Other"
	],
	"keywords": [
		"chatgpt",
		"openapi",
		"github",
		"copilot",
		"claude",
		"sonnet",
		"codegpt",
		"ai",
		"knox",
		"devops",
		"ci/cd"
	],
	"extensionKind": [
		"ui",
		"workspace"
	],
	"activationEvents": [
		"onUri",
		"onStartupFinished",
		"onView:knoxchat.knoxGUIView"
	],
	"main": "./dist/src/extension",
	"capabilities": {
		"virtualWorkspaces": false,
		"untrustedWorkspaces": {
			"supported": false
		}
	},
	"scripts": {
		"compile": "gulp compile-extension:knox",
		"watch": "gulp watch-extension:knox",
		"compile-gui": "node ./scripts/build-gui.mts",
		"rebuild-native": "node ./scripts/rebuild-native.mts",
		"test": "node ../../node_modules/mocha/bin/mocha --ui tdd --timeout 20000 --require ./src/test/vscode-stub.cjs \"./out/src/test/**/*.test.js\"",
		"test-gui": "npm test --prefix gui-src"
	},
	"dependencies": {
		"@mozilla/readability": "^0.6.0",
		"@octokit/rest": "^22.0.1",
		"dbinfoz": "^0.14.0",
		"diff": "^9.0.0",
		"dotenv": "^17.4.2",
		"fastest-levenshtein": "^1.0.16",
		"follow-redirects": "^1.16.0",
		"handlebars": "^4.7.9",
		"http-proxy-agent": "^9.1.0",
		"https-proxy-agent": "^9.1.0",
		"i18next": "^26.4.2",
		"ignore": "^7.0.8",
		"jsdom": "^30.0.1",
		"minisearch": "^7.2.0",
		"monaco-vscode-textmate-theme-converter": "^0.1.7",
		"node-fetch": "^3.3.2",
		"node-html-markdown": "^2.0.0",
		"node-machine-id": "^1.1.12",
		"openai": "^7.10.0",
		"partial-json": "^0.1.7",
		"pg": "^8.23.0",
		"sqlite": "^5.1.1",
		"svg-builder": "^3.0.4",
		"systeminformation": "^5.33.8",
		"tree-sitter-wasms": "^0.1.13",
		"uuid": "^14.0.2",
		"web-tree-sitter": "^0.27.0",
		"yaml": "^2.9.0",
		"zod": "^4.5.4"
	},
	"optionalDependencies": {
		"mac-ca": "^3.1.3",
		"sqlite3": "^6.0.1",
		"system-ca": "^3.0.0",
		"win-ca": "^3.5.1"
	},
	"overrides": {
		"sqlite3": "$sqlite3"
	},
	"contributes": {
		"languages": [
			{
				"id": "promptLanguage",
				"extensions": [
					".prompt"
				],
				"aliases": [
					"Prompt Language"
				],
				"configuration": "./prompt-file-language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "promptLanguage",
				"scopeName": "source.prompt",
				"path": "./media/prompt.tmLanguage.json"
			}
		],
		"configuration": {
			"title": "Knox",
			"properties": {
				"knoxchat.showInlineTip": {
					"type": "boolean",
					"default": true,
					"description": "Show inline suggestions for Knox shortcuts (e.g., \"Cmd/Ctrl L to add code to chat, Cmd/Ctrl I to edit code\")"
				},
				"knoxchat.debugViteGui": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "Load the sidebar from a local Vite server at `http://localhost:5173` instead of packaged `gui/assets`. Also enabled when `KNOX_GUI_VITE=1`. Off by default."
				},
				"knoxchat.disableQuickFix": {
					"type": "boolean",
					"default": false,
					"description": "Disable quick fix functionality"
				},
				"knoxchat.enableQuickActions": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "Enable quick actions functionality"
				},
				"knoxchat.enablePostEditVerification": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "After mutating tool calls (create/edit/generate tests), automatically check diagnostics and attempt LLM fixes. Applies to both chat and agent mode. Ignored when `knoxchat.verifyCommand` is set or `knoxchat.agentProfile` is `systems` / `rust` (compile oracle)."
				},
				"knoxchat.agentProfile": {
					"type": "string",
					"enum": [
						"default",
						"systems",
						"rust",
						"auto"
					],
					"default": "default",
					"markdownDescription": "Agent loop profile. `default`: unlimited tool rounds, LSP verify. `systems`: unlimited rounds, doom-loop 5, post-edit `make` oracle (kernel/QEMU). `rust`: unlimited rounds, doom-loop 4, `cargo check --workspace --all-targets`. `auto`: systems on Kconfig+arch / QEMU meson+target, rust on a root Cargo.toml. Stop a run with Cancel."
				},
				"knoxchat.verifyCommand": {
					"type": "string",
					"default": "",
					"markdownDescription": "Incremental build to run after Agent file edits (compile oracle). Example: `make -j8` or `cargo check --workspace --all-targets`. When set, LSP post-edit verification is skipped. Empty = LSP diagnostics (default for TS/JS)."
				},
				"knoxchat.verifyMode": {
					"type": "string",
					"enum": [
						"diagnostics",
						"command",
						"off"
					],
					"default": "diagnostics",
					"markdownDescription": "Post-edit oracle: `diagnostics` (LSP), `command` (`knoxchat.verifyCommand` / make), or `off`. A non-empty verifyCommand selects `command`."
				},
				"knoxchat.verifyMaxIterations": {
					"type": "number",
					"default": 8,
					"minimum": 1,
					"maximum": 20,
					"markdownDescription": "Skip further auto-builds after this many identical compiler error signatures (circuit breaker)."
				},
				"knoxchat.enableShadowPreview": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "Before applying a chat edit to an existing non-empty file, show a side-by-side shadow diff. Accept continues the normal vertical-diff apply path; Reject discards the proposal. Files over 4000 lines skip shadow unless `knoxchat.shadowPreviewLargeFiles` is true."
				},
				"knoxchat.shadowPreviewLargeFiles": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "Allow shadow preview on files larger than 4000 lines. Default off so 10k-line C files use the vertical diff / apply_patch preview instead."
				},
				"knox.checkpoints.maxCheckpoints": {
					"type": "number",
					"default": 1000,
					"minimum": 1,
					"maximum": 10000,
					"description": "Maximum number of checkpoints"
				},
				"knox.checkpoints.retentionDays": {
					"type": "number",
					"default": 7,
					"minimum": 1,
					"maximum": 365,
					"description": "Checkpoint retention days"
				},
				"knox.checkpoints.maxStorageBytes": {
					"type": "number",
					"default": 1000000000,
					"minimum": 1048576,
					"description": "Maximum disk usage for checkpoint blobs and manifests (bytes). Oldest unpinned checkpoints are folded and deleted when the cap is exceeded."
				},
				"knox.checkpoints.maxFilesPerCheckpoint": {
					"type": "number",
					"default": 10000,
					"minimum": 1,
					"maximum": 100000,
					"description": "Warn when a checkpoint captures more files than this. Files are never silently dropped — truncation would make restore incomplete."
				},
				"knox.checkpoints.maxFileSizeBytes": {
					"type": "number",
					"default": 5242880,
					"minimum": 1024,
					"description": "Maximum size of a single file captured in snapshots (bytes)"
				},
				"knox.checkpoints.captureBinaryFiles": {
					"type": "boolean",
					"default": true,
					"description": "Snapshot binary files (images, fonts, PDFs, …) as base64 so they can be restored and compared"
				},
				"knox.checkpoints.enableCompression": {
					"type": "boolean",
					"default": true,
					"description": "Gzip checkpoint file blobs larger than 4KB. Restore always round-trips the original bytes."
				},
				"knox.checkpoints.encryptAtRest": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "Encrypt checkpoint blob files on disk with AES-GCM. The key is stored in the OS keychain (VS Code Secret Storage), never in the workspace. Manifests still list file paths. Enable compression is applied before encryption."
				},
				"knox.checkpoints.trackedExtensions": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"js",
						"jsx",
						"ts",
						"tsx",
						"py",
						"java",
						"cpp",
						"c",
						"cs",
						"go",
						"rs",
						"php",
						"rb",
						"swift",
						"kt",
						"html",
						"css",
						"scss",
						"json",
						"yaml",
						"yml",
						"md",
						"txt"
					],
					"description": "Tracked file extensions"
				},
				"knox.checkpoints.autoCleanup": {
					"type": "boolean",
					"default": true,
					"description": "Automatically clean up old checkpoints"
				},
				"knox.checkpoints.cleanupIntervalHours": {
					"type": "number",
					"default": 24,
					"minimum": 1,
					"maximum": 8760,
					"description": "Cleanup interval (hours)"
				},
				"knox.checkpoints.enableAutoCheckpoints": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "Create a checkpoint after AI conversation turns when workspace files changed. Default is **true**. Independent of time/file-threshold auto-checkpoints (`knox.checkpoints.auto.enabled`)."
				},
				"knox.checkpoints.auto.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Enable time- and file-threshold automatic checkpoints"
				},
				"knox.checkpoints.auto.minIntervalMs": {
					"type": "number",
					"default": 60000,
					"minimum": 1000,
					"description": "Minimum interval between automatic checkpoints (milliseconds)"
				},
				"knox.checkpoints.auto.maxIntervalMs": {
					"type": "number",
					"default": 300000,
					"minimum": 1000,
					"description": "Force an automatic checkpoint after this interval when files have changed (milliseconds)"
				},
				"knox.checkpoints.auto.fileChangeThreshold": {
					"type": "number",
					"default": 5,
					"minimum": 1,
					"description": "Create an automatic checkpoint after this many file changes"
				},
				"knox.checkpoints.auto.checkpointAfterAI": {
					"type": "boolean",
					"default": true,
					"description": "Create an automatic checkpoint when an AI operation completes"
				},
				"knox.checkpoints.auto.checkpointBeforeRisky": {
					"type": "boolean",
					"default": true,
					"description": "Create an automatic checkpoint before mutating/risky tool operations"
				},
				"knox.checkpoints.auto.maxUndoStack": {
					"type": "number",
					"default": 50,
					"minimum": 1,
					"maximum": 500,
					"description": "Maximum automatic-checkpoint undo stack size"
				},
				"knox.checkpoints.auto.showNotifications": {
					"type": "boolean",
					"default": false,
					"description": "Show a notification when an automatic checkpoint is created"
				},
				"knox.checkpoints.auto.debounceMs": {
					"type": "number",
					"default": 3000,
					"minimum": 100,
					"description": "Debounce file-change events before evaluating automatic checkpoints (milliseconds)"
				},
				"knox.checkpoints.smart.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Enable the smart AI-session checkpoint tracker"
				},
				"knox.checkpoints.smart.agentModeOnly": {
					"type": "boolean",
					"default": true,
					"description": "Only track AI-session files while Agent mode is active"
				},
				"knox.checkpoints.smart.maxTrackedFiles": {
					"type": "number",
					"default": 100,
					"minimum": 1,
					"description": "Maximum files tracked in a smart AI session"
				},
				"knox.checkpoints.smart.maxMemoryUsageMB": {
					"type": "number",
					"default": 50,
					"minimum": 1,
					"description": "Memory budget for smart AI-session tracking (MB)"
				},
				"knox.checkpoints.smart.maxCheckpoints": {
					"type": "number",
					"default": 50,
					"minimum": 1,
					"description": "Maximum checkpoints retained for a smart AI session"
				},
				"knox.checkpoints.smart.maxFileSizeKB": {
					"type": "number",
					"default": 100,
					"minimum": 1,
					"description": "Skip files larger than this in smart AI-session tracking (KB)"
				},
				"knox.checkpoints.smart.verboseLogging": {
					"type": "boolean",
					"default": false,
					"description": "Verbose logging for smart AI-session checkpoints"
				},
				"knox.checkpoints.smart.enableMetrics": {
					"type": "boolean",
					"default": true,
					"description": "Record AI-session file, line, and rollback metrics on the Checkpoints dashboard"
				},
				"knox.checkpoints.inlineDiff.enabled": {
					"type": "boolean",
					"default": false,
					"description": "Show gutter and inline decorations comparing the open editor to a checkpoint (last checkpoint, or one picked via Show Inline Diff)"
				},
				"knox.checkpoints.inlineDiff.showLineDecorations": {
					"type": "boolean",
					"default": true,
					"description": "Highlight changed lines when inline checkpoint diff is enabled"
				},
				"knox.checkpoints.inlineDiff.showGutterIcons": {
					"type": "boolean",
					"default": true,
					"description": "Show gutter icons for checkpoint diffs"
				},
				"knox.checkpoints.inlineDiff.showHoverPreviews": {
					"type": "boolean",
					"default": true,
					"description": "Show hover previews of original checkpoint content"
				},
				"knox.checkpoints.inlineDiff.showCodeLens": {
					"type": "boolean",
					"default": true,
					"description": "Show CodeLens actions for checkpoint inline diffs"
				},
				"knox.checkpoints.inlineDiff.highlightWordChanges": {
					"type": "boolean",
					"default": true,
					"description": "Highlight word-level changes inside modified lines"
				}
			}
		},
